#!/usr/bin/env python3
"""Stop personal names and private details from landing in a PUBLIC repo's commits.

Run by the global hooks in ~/dotfiles/git/hooks (git config --global core.hooksPath):
    public-guard pre-commit          scan the staged lines that are being added, and file names
    public-guard commit-msg FILE     scan the commit message (land's drafts included)
Also run by ship and by Claude Code (a PreToolUse hook in ~/.claude/settings.json):
    public-guard paths REPO PATH...  scan files about to be deployed (ship: a site is public)
    public-guard text                scan stdin
    public-guard claude-hook         a Claude Code hook: stdin is the tool call; refuses
                                     commits and pushes to public repos, gh descriptions and
                                     release notes, and Artifact pages that carry a term

Only repos whose GitHub remote is public are checked: `gh` is asked once a day per repo
and the answer cached in .git/public-guard. No GitHub remote: checked only if the repo
has a .ship file (it deploys somewhere public, like karkhana's bench site).
PUBLIC_GUARD=force checks any repo; PUBLIC_GUARD=off skips; `git commit --no-verify`
skips the hooks for one commit.

What it looks for:
  - terms from ~/.config/git/private-terms.txt (private, outside every repo): one per line,
    '#' comments. A term with a capital letter matches that case only (so "Don" doesn't
    catch "don't"); an all-lowercase term matches any case; "re:<regex>" is a regex.
  - email addresses, except noreply / example ones.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

TERMS = Path.home() / ".config/git/private-terms.txt"
TTL = 86400
EMAIL = re.compile(r"[\w.+-]+@[\w-]+(\.[\w-]+)+")
EMAIL_OK = re.compile(r"(noreply|no-reply|example\.(com|org|net)|localhost|\.local$|users\.noreply\.github\.com)", re.I)


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def github_slug():
    for remote in git("remote").split():
        url = git("remote", "get-url", remote).strip()
        m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(\.git)?$", url)
        if m:
            return f"{m[1]}/{m[2]}"
    return None


def is_public():
    mode = os.environ.get("PUBLIC_GUARD", "")
    if mode == "off":
        return False
    if mode == "force":
        return True
    slug = github_slug()
    if not slug:
        top = git("rev-parse", "--show-toplevel").strip()
        return bool(top) and (Path(top) / ".ship").exists()
    cache = Path(git("rev-parse", "--git-common-dir").strip()) / "public-guard"
    try:
        ts, state, cached_slug = cache.read_text().split()
        if cached_slug == slug and time.time() - float(ts) < TTL:
            return state == "public"
    except (OSError, ValueError):
        pass
    r = subprocess.run(["gh", "repo", "view", slug, "--json", "isPrivate"], capture_output=True, text=True)
    try:
        public = not json.loads(r.stdout)["isPrivate"]
    except (json.JSONDecodeError, KeyError):
        return True          # can't tell (offline?): check anyway, a false alarm is cheap
    try:
        cache.write_text(f"{time.time()} {'public' if public else 'private'} {slug}\n")
    except OSError:
        pass
    return public


def patterns():
    out = []
    if not TERMS.exists():
        return out
    for line in TERMS.read_text().splitlines():
        t = line.strip()
        if not t or t.startswith("#"):
            continue
        if t.startswith("re:"):
            out.append((t, re.compile(t[3:])))
        else:
            flags = 0 if any(c.isupper() for c in t) else re.I
            # whole word; an apostrophe counts as part of a word ("Don" vs "Don't")
            out.append((t, re.compile(r"(?<![\w'])" + re.escape(t) + r"(?![\w'])", flags)))
    return out


DATA_URI = re.compile(r"data:[\w/+.-]+;base64,[A-Za-z0-9+/=]+")


def scan(lines, pats):
    """lines: [(where, text)] -> [(where, what, text)]"""
    hits = []
    for where, text in lines:
        text = DATA_URI.sub("", text)        # embedded images are not words
        for name, rx in pats:
            if rx.search(text):
                hits.append((where, name, text))
        for m in EMAIL.finditer(text):
            if not EMAIL_OK.search(m.group(0)):
                hits.append((where, "email " + m.group(0), text))
    return hits


def staged_lines():
    out, path, n = [], "?", 0
    for line in git("diff", "--cached", "-U0", "--no-color", "--diff-filter=ACMR").splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else line[4:]
            out.append((f"{path} (file name)", path))
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            n = int(m[1]) if m else 0
        elif line.startswith("+"):
            out.append((f"{path}:{n}", line[1:]))
            n += 1
    return out


def message_lines(file):
    text = Path(file).read_text(errors="replace")
    return [(f"commit message line {i}", l) for i, l in enumerate(text.splitlines(), 1)
            if not l.startswith("#")]


def file_lines(repo, paths):
    """Every text line of every file under paths (relative to repo), as ship deploys them."""
    out = []
    for p in paths:
        root = Path(repo) / p
        files = [root] if root.is_file() else sorted(f for f in root.rglob("*") if f.is_file())
        for f in files:
            if any(part.startswith(".") for part in f.relative_to(repo).parts):
                continue
            try:
                data = f.read_bytes()
            except OSError:
                continue
            if b"\0" in data[:8192]:
                continue                     # binary
            rel = f.relative_to(repo)
            out.append((f"{rel} (file name)", str(rel)))
            for i, l in enumerate(data.decode(errors="replace").splitlines(), 1):
                out.append((f"{rel}:{i}", l))
    return out


def report(hits, what):
    print(f"public-guard: {len(hits)} private mention(s) in {what}:", file=sys.stderr)
    for where, name, text in hits[:20]:
        print(f"  {where}: {name}   | {text.strip()[:100]}", file=sys.stderr)


def in_repo(cwd):
    """Run git (and is_public) as if from cwd."""
    try:
        os.chdir(cwd)
        return True
    except OSError:
        return False


def claude_hook():
    """Claude Code PreToolUse: deny a publishing tool call that carries a private term."""
    try:
        call = json.load(sys.stdin)
    except json.JSONDecodeError:
        return
    tool, inp = call.get("tool_name", ""), call.get("tool_input", {}) or {}
    cwd = call.get("cwd") or os.getcwd()
    pats, lines, what = patterns(), [], ""
    if tool == "Bash":
        cmd = inp.get("command", "")
        # a cd or -C at the front picks the repo
        m = re.search(r"(?:^|&&|;)\s*cd\s+([^\s;&|]+)", cmd) or re.search(r"git\s+-C\s+([^\s;&|]+)", cmd)
        if m:
            cwd = os.path.expanduser(m.group(1).strip("'\""))
        if re.search(r"\bgh\s+(repo\s+(edit|create)|release\s+(create|edit)|gist\s+create|pr\s+(create|edit|comment)|issue\s+(create|edit|comment))\b", cmd):
            lines, what = [("the gh command", l) for l in cmd.splitlines()], "a GitHub publish"
        elif re.search(r"\bgit\b[^|;&]*\bpush\b", cmd) and in_repo(cwd) and is_public():
            log = git("log", "-p", "--no-color", "HEAD", "--not", "--remotes")
            lines = [("an unpushed commit", l[1:] if l.startswith("+") else l) for l in log.splitlines()
                     if not l.startswith("-")]
            what = "a push to a PUBLIC repo"
        elif re.search(r"\bgit\b[^|;&]*\bcommit\b", cmd) and in_repo(cwd) and is_public():
            lines = staged_lines() + [("the git commit command", l) for l in cmd.splitlines()]
            what = "a commit to a PUBLIC repo"
    elif tool == "Artifact" and inp.get("file_path"):
        f = Path(inp["file_path"])
        if f.is_file():
            lines = [(f"{f.name}:{i}", l) for i, l in enumerate(f.read_text(errors="replace").splitlines(), 1)]
            what = "an Artifact page"
    hits = scan(lines, pats) if lines else []
    if not hits:
        return
    found = ", ".join(sorted({w for _, w, _ in hits}))
    where = "; ".join(sorted({w for w, _, _ in hits})[:6])
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny",
        "permissionDecisionReason": f"public-guard: {what} mentions private terms ({found}) at {where}. "
                                    "Reword or remove them first; the term list is ~/.config/git/private-terms.txt."}}))


def main():
    modes = ("pre-commit", "commit-msg", "paths", "text", "claude-hook")
    if len(sys.argv) < 2 or sys.argv[1] not in modes:
        sys.exit(__doc__)
    mode = sys.argv[1]
    if mode == "claude-hook":
        return claude_hook()
    if mode == "text":
        hits = scan([(f"line {i}", l) for i, l in enumerate(sys.stdin.read().splitlines(), 1)], patterns())
        if hits:
            report(hits, "the text")
            sys.exit(1)
        return
    if mode == "paths":
        repo = sys.argv[2]
        hits = scan(file_lines(repo, sys.argv[3:]), patterns())
        if hits:
            report(hits, "files about to be deployed")
            print(f"Blocked: {', '.join(sorted({w for _, w, _ in hits}))[:120]}", file=sys.stderr)
            sys.exit(1)
        return
    if not is_public():
        return
    lines = staged_lines() if mode == "pre-commit" else message_lines(sys.argv[2])
    hits = scan(lines, patterns())
    if not hits:
        return
    print(f"public-guard: {len(hits)} private mention(s) in a commit to a PUBLIC repo:", file=sys.stderr)
    for where, what, text in hits[:20]:
        print(f"  {where}: {what}   | {text.strip()[:100]}", file=sys.stderr)
    print("Reword or remove them (terms: ~/.config/git/private-terms.txt); "
          "or commit with --no-verify if it's really fine.", file=sys.stderr)
    # last line is what the deck shows on the tile
    print(f"Blocked: {', '.join(sorted({w for _, w, _ in hits}))[:120]}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
