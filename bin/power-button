#!/usr/bin/env bash
# Power button: a tap opens the quickshell power menu (Lock first, so tap then
# Enter locks); a second tap closes it.
#
# Hyprland runs this on the key (binds in hypr/hyprland.lua); logind is told
# to ignore it (nixos/power.nix) so nothing else acts on it.
#
# Why not "tap locks, hold opens the menu" (the first design, 2026-10-24):
# on this laptop every press reaches userspace as one instant press+release,
# 13-30 ms apart, whether tapped or held for 2 s (measured 2026-11-13). The
# kernel's ACPI button driver reports each EC notification as a complete
# keystroke, so a hold can't be seen.
#
#   power-button        toggle the menu
set -u
exec qs ipc call powermenu toggle
