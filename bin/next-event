#!/usr/bin/env python3
"""next-event: the coming calendar events, for the deck's clock tab (Deck.qml).

    next-event                 ask Google if the last answer is over 15 min old, write the cache
    next-event --force         ask now
    next-event login [FILE]    one-time setup: FILE is the OAuth client JSON from Google Cloud
                               (default: the newest ~/Downloads/client_secret_*.json, moved into
                               place); opens the browser to sign in, then shows what's next

Reads the primary calendar through the Google Calendar API, read-only, with a Desktop OAuth
client from your own Cloud project (Internal, so its sign-in doesn't lapse). The client and
the refresh token live in ~/.config/deck/, mode 600, outside this public repo.

Writes ~/.cache/deck/events.json: { fetched, error, events: [{ start, title }] }, start in
unix seconds, soonest first, for the next 30 days. Timed events only: an all-day event or
a holiday would sit in front of the next thing you have to be at. Cancelled events, ones
you declined and working-location markers are left out. A failed fetch keeps the last
answer, so the deck still works offline and `fetched` says how old it is; error is "login"
when Google wants a new sign-in. Standard library only.
"""

import base64
import datetime as dt
import glob
import hashlib
import http.server
import json
import os
import secrets
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "deck"
CLIENT = CONFIG / "google-client.json"
TOKEN = CONFIG / "google-token.json"
OUT = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "deck/events.json"
SCOPE = "https://www.googleapis.com/auth/calendar.events.readonly"
AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
EVENTS_URL = "https://www.googleapis.com/calendar/v3/calendars/primary/events"
FRESH = 15 * 60
DAYS = 30
LOGIN_WAIT = 300


class NeedsLogin(Exception):
    pass


def private_write(path, data):
    """Write through a rename so a reader never sees half a file; only this user can read it."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def client():
    c = json.loads(CLIENT.read_text()).get("installed")
    if not c:
        raise ValueError("not a Desktop app OAuth client")
    return c


def post_token(fields):
    body = urllib.parse.urlencode(fields).encode()
    with urllib.request.urlopen(urllib.request.Request(TOKEN_URL, body), timeout=15) as r:
        return json.load(r)


def access_token():
    c = client()
    try:
        return post_token({"client_id": c["client_id"], "client_secret": c["client_secret"],
                           "grant_type": "refresh_token",
                           "refresh_token": json.loads(TOKEN.read_text())["refresh_token"]})["access_token"]
    except urllib.error.HTTPError as e:
        if e.code in (400, 401):                      # revoked, expired, or the client was replaced
            raise NeedsLogin from None
        raise


def fetch_events():
    now = dt.datetime.now(dt.timezone.utc)
    query = urllib.parse.urlencode({"singleEvents": "true", "orderBy": "startTime", "maxResults": 60,
                                    "timeMin": now.isoformat(), "timeMax": (now + dt.timedelta(days=DAYS)).isoformat()})
    ask = urllib.request.Request(f"{EVENTS_URL}?{query}", headers={"Authorization": "Bearer " + access_token()})
    try:
        with urllib.request.urlopen(ask, timeout=15) as r:
            items = json.load(r).get("items", [])
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise NeedsLogin from None
        raise
    events = []
    for e in items:
        when = e.get("start", {}).get("dateTime")     # (an all-day event has a date instead)
        if not when or e.get("status") == "cancelled" or e.get("eventType") == "workingLocation":
            continue
        if any(a.get("self") and a.get("responseStatus") == "declined" for a in e.get("attendees", [])):
            continue
        start = int(dt.datetime.fromisoformat(when).timestamp())
        if start > now.timestamp():                   # (timeMin also returns what's under way)
            events.append({"start": start, "title": e.get("summary", "(no title)")})
    return events[:40]


def refresh(force=False):
    if not TOKEN.exists():
        OUT.unlink(missing_ok=True)
        return
    old = json.loads(OUT.read_text()) if OUT.exists() else {}
    if not force and time.time() - old.get("fetched", 0) <= FRESH:
        return
    answer = {"fetched": old.get("fetched", 0), "error": "", "events": old.get("events", [])}
    try:
        answer.update(events=fetch_events(), fetched=int(time.time()))
    except NeedsLogin:
        answer["error"] = "login"
    except Exception as e:
        answer["error"] = type(e).__name__
    private_write(OUT, json.dumps(answer).encode())


def open_browser(url):
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wait_for_code(state, url_for):
    """Google sends the browser back to a one-shot server here, with the code."""
    got = {}

    class Back(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("state") == [state]:
                got.update(code=q.get("code", [""])[0], error=q.get("error", [""])[0])
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(b"Done: you can close this tab." if got.get("code") else b"Not signed in.")

        def log_message(self, *_):                    # the query holds the code: keep it out of the terminal
            pass

    with http.server.HTTPServer(("127.0.0.1", 0), Back) as server:
        server.timeout = 2
        redirect = f"http://127.0.0.1:{server.server_port}"
        open_browser(url_for(redirect))
        end = time.time() + LOGIN_WAIT
        while not got and time.time() < end:
            server.handle_request()
    return got, redirect


def install_client(path):
    if path:
        src = Path(path)
    else:
        found = sorted(glob.glob(str(HOME / "Downloads/client_secret_*.json")), key=os.path.getmtime)
        if not found and not CLIENT.exists():
            sys.exit("no ~/Downloads/client_secret_*.json: download the OAuth client from Google Cloud first")
        src = Path(found[-1]) if found else None
    if src:
        c = json.loads(src.read_text())
        if "installed" not in c:
            sys.exit("that OAuth client isn't the Desktop app type; nothing changed")
        private_write(CLIENT, src.read_bytes())
        if not path:
            os.remove(src)                            # it's a credential: moved, not copied


def login(path=None):
    install_client(path)
    c = client()
    state = secrets.token_urlsafe(16)
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()

    def url_for(redirect):
        return AUTH_URL + "?" + urllib.parse.urlencode({
            "client_id": c["client_id"], "redirect_uri": redirect, "response_type": "code", "scope": SCOPE,
            "access_type": "offline", "prompt": "consent", "state": state,
            "code_challenge": challenge, "code_challenge_method": "S256"})

    print("Sign in in the browser window (it waits 5 minutes).")
    got, redirect = wait_for_code(state, url_for)
    if not got.get("code"):
        sys.exit(f"not signed in ({got.get('error') or 'timed out'})")
    try:
        t = post_token({"client_id": c["client_id"], "client_secret": c["client_secret"], "code": got["code"],
                        "code_verifier": verifier, "grant_type": "authorization_code", "redirect_uri": redirect})
    except urllib.error.HTTPError as e:
        sys.exit(f"Google refused the sign-in (HTTP {e.code})")
    if "refresh_token" not in t:
        sys.exit("Google gave no refresh token; nothing saved")
    private_write(TOKEN, json.dumps({"refresh_token": t["refresh_token"]}).encode())
    refresh(force=True)
    answer = json.loads(OUT.read_text())
    if answer["error"]:
        sys.exit(f"signed in, but reading the calendar failed ({answer['error']}): is the Calendar API enabled?")
    print(f"{len(answer['events'])} event(s) in the next {DAYS} days")
    for e in answer["events"][:3]:
        print(" ", dt.datetime.fromtimestamp(e["start"]).strftime("%a %-d %b %H:%M"), e["title"])


if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:1] == ["login"]:
        login(*args[1:2])
    else:
        signal.alarm(60)                              # a hung fetch must not outlive the deck
        refresh(force="--force" in args)
