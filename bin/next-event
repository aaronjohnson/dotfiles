#!/usr/bin/env nix-shell
#!nix-shell -i python3 -p "python3.withPackages (ps: [ ps.icalendar ps.recurring-ical-events ])"
"""next-event: the coming calendar events, for the deck's clock tab (Deck.qml).

    next-event            fetch the feeds if the last fetch is over 15 min old, write the cache
    next-event --force    fetch now
    next-event add        add a feed: prompts for its URL (not echoed), then shows what's next

Feeds are Google Calendar's "Secret address in iCal format" (Settings > your calendar >
Integrate calendar), one per line in ~/.config/deck/calendars.txt. Those URLs are read
access to the calendar, so the file is private and mode 600, outside this public repo;
see deck/calendars.example.txt.

Writes ~/.cache/deck/events.json: { fetched, error, events: [{ start, title }] }, start in
unix seconds, soonest first, for the next 30 days. Timed events only: an all-day event or
a holiday would sit in front of the next thing you have to be at. Cancelled events and ones
you declined are left out. A failed fetch keeps that feed's last copy, so the deck still
answers offline and `fetched` says how old the answer is.
"""

import datetime as dt
import getpass
import hashlib
import json
import os
import signal
import sys
import time
import urllib.request
from pathlib import Path

import icalendar
import recurring_ical_events

HOME = Path.home()
FEEDS = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "deck/calendars.txt"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "deck"
OUT = CACHE / "events.json"
FRESH = 15 * 60
DAYS = 30


def private_write(path, data):
    """Write through a rename so a reader never sees half a file; only this user can read it."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def feeds():
    if not FEEDS.exists():
        return []
    lines = (line.strip() for line in FEEDS.read_text().splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def copy_of(url):
    return CACHE / (hashlib.sha256(url.encode()).hexdigest()[:16] + ".ics")


def fetch(url):
    with urllib.request.urlopen(url, timeout=15) as r:
        private_write(copy_of(url), r.read())


def declined(event, me):
    who = event.get("ATTENDEE", [])
    for a in who if isinstance(who, list) else [who]:
        if str(a).lower().removeprefix("mailto:") == me and a.params.get("PARTSTAT") == "DECLINED":
            return True
    return False


def events_in(ics, now):
    cal = icalendar.Calendar.from_ical(ics)
    me = str(cal.get("X-WR-CALNAME", "")).lower()     # a primary calendar is named for its address
    span = recurring_ical_events.of(cal).between(now - dt.timedelta(days=1), now + dt.timedelta(days=DAYS))
    for e in span:
        start = e["DTSTART"].dt
        if not isinstance(start, dt.datetime):        # all-day
            continue
        if str(e.get("STATUS", "")).upper() == "CANCELLED" or declined(e, me):
            continue
        yield {"start": int(start.timestamp()), "title": str(e.get("SUMMARY", "(no title)"))}


def refresh(force=False):
    urls = feeds()
    if not urls:
        OUT.unlink(missing_ok=True)
        return
    old = json.loads(OUT.read_text()) if OUT.exists() else {}
    stale = time.time() - old.get("fetched", 0) > FRESH
    error, fetched = "", old.get("fetched", 0)
    if force or stale or not all(copy_of(u).exists() for u in urls):
        failed = 0
        for url in urls:
            try:
                fetch(url)
            except Exception as e:                    # never print e: it can carry the secret URL
                failed += 1
                error = type(e).__name__
        if not failed:
            fetched = int(time.time())
    now = dt.datetime.now(dt.timezone.utc)
    events = []
    for url in urls:
        if copy_of(url).exists():
            events.extend(events_in(copy_of(url).read_bytes(), now))
    events = sorted((e for e in events if e["start"] > now.timestamp()), key=lambda e: e["start"])
    private_write(OUT, json.dumps({"fetched": fetched, "error": error, "events": events[:40]}).encode())


def add():
    url = getpass.getpass("iCal secret address (not shown): ").strip()
    if not url.startswith("https://"):
        sys.exit("that isn't an https address; nothing added")
    fetch(url)                                        # proves the address before keeping it
    have = feeds()
    if url not in have:
        lines = FEEDS.read_text() if FEEDS.exists() else ""
        private_write(FEEDS, (lines + url + "\n").encode())
    refresh(force=True)
    upcoming = json.loads(OUT.read_text())["events"]
    print(f"{len(feeds())} feed(s), {len(upcoming)} event(s) in the next {DAYS} days")
    for e in upcoming[:3]:
        print(" ", dt.datetime.fromtimestamp(e["start"]).strftime("%a %-d %b %H:%M"), e["title"])


if __name__ == "__main__":
    signal.alarm(60)                                  # a hung fetch must not outlive the deck
    if sys.argv[1:] == ["add"]:
        signal.alarm(0)                               # it waits on a person
        add()
    else:
        refresh(force="--force" in sys.argv[1:])
