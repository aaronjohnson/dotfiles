#!/usr/bin/env bash
# land: land changes, from drafted commits to the running system. Super+F12 in Hyprland.
#
# Every outward step asks first:
#   1. commit each repo with a drafted message waiting in .git/COMMIT_DRAFT (written by
#      Claude), after showing the staged changes; ~/nixos last;
#   2. for a repo ~/nixos takes as a flake input (jantar, nixos-intel-npu, misra): push it, point
#      ~/nixos's lock at the new commit, build, and draft the ~/nixos commit;
#   3. commit ~/nixos, switch to it (password through polkit: pkexec), then push it.
# With no drafts waiting it shows the recent commits and offers to switch to ~/nixos as it is.
# LAND_EMBED=1 (how `ship` runs it first): only the drafts; no recent-commits view, no closing key.
#
# One step at a time (the quickshell deck, Super+F12, runs these; a click is the "yes"):
#   land commit|bump|push|discard REPO  ·  land switch  ·  land needs-switch
# LAND_YES=1 answers every question yes and skips the "press Enter" pauses.
set -u
notify() {
  [[ -n "${LAND_YES:-}" ]] && return   # the deck shows the result on the tile; no pile of cards
  set -- "$1" "$(date +%H:%M) · $2" "${3:-6000}"   # timestamp every notification
  if command -v notify-send >/dev/null; then notify-send -a git -t "${3:-6000}" "$1" "$2"
  else gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify "git" 0 "" "$1" "$2" "[]" "{}" "${3:-6000}" >/dev/null 2>&1; fi
}
ask() { [[ -n "${LAND_YES:-}" ]] && { echo "$1 yes"; return 0; }; local ans; read -rp "$1 [y/N] " ans; [[ "$ans" == [yY]* ]]; }
pause() { [[ -n "${LAND_YES:-}" ]] && return; read -rp "Press Enter to continue." _; }

nixos="$HOME/nixos"
# Repos ~/nixos takes as flake inputs: path -> input name.
declare -A inputs=(["$HOME/src/jantar"]=jantar ["$HOME/nixos-intel-npu"]=nixos-intel-npu ["$HOME/src/misra"]=misra)
others=("$HOME/dotfiles" "$HOME/nixos-intel-npu" "$HOME"/src/*/)
start_head=$(git -C "$nixos" rev-parse HEAD 2>/dev/null)

has_draft() { [[ -f "$1/.git/COMMIT_DRAFT" ]]; }

# Show one repo's staged changes and draft; commit on yes. Returns 0 if it committed.
commit_repo() {
  local r="$1" name="${1/#"$HOME"/\~}"
  printf '\n\e[1m== %s ==\e[0m\n' "$name"
  if git -C "$r" diff --cached --quiet; then
    echo "A draft is waiting, but nothing is staged (it may already be committed):"
    sed 's/^/  /' "$r/.git/COMMIT_DRAFT" | head -3
    if ask "Delete this stale draft?"; then rm "$r/.git/COMMIT_DRAFT"; notify "Removed stale draft" "$name"; fi
    return 1
  fi
  printf '\e[1mStaged changes:\e[0m\n'
  git -C "$r" -c color.ui=always diff --cached --stat
  printf '\n\e[1mMessage:\e[0m\n'
  printf '\e[36m┌%s\e[0m\n' "$(printf '─%.0s' {1..70})"
  sed 's/^/\x1b[36m│\x1b[0m /' "$r/.git/COMMIT_DRAFT"
  printf '\e[36m└%s\e[0m\n\n' "$(printf '─%.0s' {1..70})"
  ask "Commit $name?" || return 1
  if git -C "$r" commit -q -F "$r/.git/COMMIT_DRAFT" && rm "$r/.git/COMMIT_DRAFT"; then
    notify "Committed $name ✓" "$(git -C "$r" log --oneline -1)"
    return 0
  fi
  notify "Commit failed: $name ✗" "See the commit window." 0
  pause
  return 1
}

# After committing a flake input: push it, point ~/nixos at it, build, draft the bump.
bump_nixos() {
  local r="$1" input="$2" name="${1/#"$HOME"/\~}" rev subject
  ask "Push $name and update ~/nixos to it?" || return
  printf '\e[2mgit push\e[0m\n'
  if ! git -C "$r" push; then notify "Push failed: $name ✗" "Nothing else changed." 0; pause; return; fi
  rev=$(git -C "$r" rev-parse --short HEAD)
  subject=$(git -C "$r" log -1 --format=%s)
  # --refresh: Nix otherwise reuses its cached idea of the branch for an hour.
  printf '\e[2mnix flake update %s --refresh\e[0m\n' "$input"
  if ! (cd "$nixos" && nix flake update "$input" --refresh); then
    notify "Updating ~/nixos failed ✗" "$input: see the commit window." 0; pause; return
  fi
  if git -C "$nixos" diff --quiet -- flake.lock; then
    echo "~/nixos already points at $input $rev."
    return
  fi
  printf '\e[2mbuilding the new system (no switch yet)...\e[0m\n'
  if ! (cd "$nixos" && nix build --no-link ".#nixosConfigurations.hadron.config.system.build.toplevel" 2>&1 | tail -5; exit "${PIPESTATUS[0]}"); then
    notify "~/nixos doesn't build with $input $rev ✗" "flake.lock is updated but not staged." 0
    pause
    return
  fi
  git -C "$nixos" add flake.lock
  local draft="$nixos/.git/COMMIT_DRAFT"
  if [[ -f "$draft" ]]; then
    # Another draft is waiting: add the bump to it.
    printf '\nAlso bumps %s to %s: %s\n' "$input" "$rev" "$subject" >> "$draft"
  else
    printf '%s: %s\n\nBumps %s to %s.\n' "$input" "$subject" "$input" "$rev" > "$draft"
  fi
  echo "~/nixos: flake.lock staged, draft written."
}

# Does ~/nixos build to something other than the running system? Builds as the user
# (no password; usually cached), so a switch that would change nothing isn't offered.
# 0: different, 1: the same, 2: doesn't build.
needs_switch() {
  local built
  printf '\e[2mbuilding ~/nixos to compare with the running system...\e[0m\n'
  built=$(cd "$nixos" && nix build --no-link --print-out-paths \
    ".#nixosConfigurations.hadron.config.system.build.toplevel" 2>"${XDG_RUNTIME_DIR:-/tmp}/land-build.log") || {
    tail -5 "${XDG_RUNTIME_DIR:-/tmp}/land-build.log"
    notify "~/nixos doesn't build ✗" "No switch offered; see the land window." 0
    return 2
  }
  [[ "$built" != "$(readlink /run/current-system)" ]]
}

# Offer a switch if it would change something; return 0 if switched or already running.
offer_switch() {
  local prompt="$1" state
  needs_switch; state=$?
  case $state in
    1) echo "The running system is already this configuration: nothing to switch."; return 0 ;;
    2) return 1 ;;
  esac
  ask "$prompt" && switch_nixos
}

# Switch to ~/nixos, the password asked through polkit.
switch_nixos() {
  local log="${XDG_RUNTIME_DIR:-/tmp}/nixos-switch.log" gen
  notify "NixOS switch" "Approve in the password dialog."
  [[ -n "$(git -C "$nixos" status --porcelain 2>/dev/null)" ]] &&
    printf '\e[33mNote: ~/nixos has uncommitted changes; they are included.\e[0m\n'
  printf '\e[2mpkexec nixos-rebuild switch --flake ~/nixos#hadron\e[0m\n'
  pkexec /run/current-system/sw/bin/nixos-rebuild switch --flake "$nixos#hadron" 2>&1 | tee "$log"
  case "${PIPESTATUS[0]}" in
    0)
      gen=$(readlink /nix/var/nix/profiles/system | grep -o '[0-9]\+' | head -1)
      notify "NixOS switch ✓ generation $gen" "$(git -C "$nixos" log -1 --format='%h %s')"
      return 0 ;;
    126|127)
      notify "NixOS switch cancelled" "Not authorised; nothing changed." 4000
      return 1 ;;
    *)
      notify "NixOS switch ✗" "Failed: $(grep -m1 -i 'error' "$log" | cut -c1-140)" 0
      return 1 ;;
  esac
}

# ---- one-step subcommands (exit codes: 0 done, 1 not done) ----
if [[ $# -gt 0 ]]; then
  r="${2:-}"; r="${r%/}"
  case "$1" in
    commit)       has_draft "$r" || { echo "No draft in $r."; exit 1; }
                  git -C "$r" diff --cached --quiet && { echo "Nothing staged in $r; the draft stays (discard it with: land discard)."; exit 1; }
                  commit_repo "$r" || exit 1
                  # a flake input's commit is only half the job: the deck offers Bump next
                  exit 0 ;;
    bump)         [[ -n "${inputs[$r]:-}" ]] || { echo "$r is not a ~/nixos flake input."; exit 1; }
                  bump_nixos "$r" "${inputs[$r]}"
                  git -C "$nixos" diff --cached --quiet -- flake.lock && exit 1 || exit 0 ;;
    push)         printf '\e[2mgit push\e[0m\n'
                  if git -C "$r" push; then notify "Pushed ${r/#"$HOME"/\~} ✓" "$(git -C "$r" log --oneline -1)"; exit 0; fi
                  notify "Push failed: ${r/#"$HOME"/\~} ✗" "See the deck." 0; exit 1 ;;
    discard)      rm -f "$r/.git/COMMIT_DRAFT" && notify "Removed draft" "${r/#"$HOME"/\~}"; exit 0 ;;
    switch)       switch_nixos; exit $? ;;
    needs-switch) needs_switch; exit $? ;;
    *)            echo "usage: land [commit|bump|push|discard REPO | switch | needs-switch]"; exit 2 ;;
  esac
fi

work=0
for r in "${others[@]}"; do
  r="${r%/}"
  [[ "$r" == "$nixos" ]] && continue
  has_draft "$r" || continue
  work=1
  if commit_repo "$r" && [[ -n "${inputs[$r]:-}" ]]; then bump_nixos "$r" "${inputs[$r]}"; fi
done
if has_draft "$nixos"; then work=1; commit_repo "$nixos"; fi

if [[ "$(git -C "$nixos" rev-parse HEAD)" != "$start_head" ]]; then
  echo
  if offer_switch "Switch to the new ~/nixos now?"; then
    echo; ask "Push ~/nixos?" && git -C "$nixos" push
  fi
fi

if [[ -n "${LAND_EMBED:-}" ]]; then exit 0; fi
if (( work == 0 )); then
  printf '\e[1mNo drafts waiting. Recent commits:\e[0m\n'
  # repos touched in the last two weeks and their newest three commits, oldest first,
  # so the newest commit is at the bottom, next to the prompt
  for r in "$nixos" "${others[@]}"; do
    r="${r%/}"; [[ -d "$r/.git" ]] || continue
    t=$(git -C "$r" log -1 --since='2 weeks ago' --format=%ct 2>/dev/null)
    [[ -n "$t" ]] && echo "$t $r"
  done | sort -n | uniq | while read -r _ r; do
    printf '\n\e[36m%s\e[0m\n' "${r/#"$HOME"/\~}"
    git -C "$r" log -3 --reverse --format='  %C(yellow)%h%C(reset) %<(70,trunc)%s %C(dim)(%cr)%C(reset)' --color=always
  done
  echo
  offer_switch "Switch to ~/nixos as it is?"
fi
printf '\n\e[2mDone. Press any key to close.\e[0m'
read -rsn1 _
