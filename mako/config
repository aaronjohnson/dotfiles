# mako: desktop notifications (top-right). Solarized; the Quickshell bar switches
# light/dark with `makoctl mode -s light|dark` at sunrise/sunset.
# After editing: makoctl reload.   Dismiss all: makoctl dismiss -a

font=monospace 11
width=340
padding=10
margin=10
border-size=2
border-radius=8
max-visible=4
# Above the quickshell popups (deck, keys menu, password prompt), not hidden behind them.
layer=overlay

# Age out after 8 s (apps can ask for longer or shorter; critical ones stay).
default-timeout=8000
# Repeats from the same app with the same title collapse into one card with a count.
group-by=app-name,summary

# Solarized Dark (the default look)
background-color=#002b36f2
text-color=#93a1a1
border-color=#2aa198
progress-color=over #586e75

[urgency=low]
border-color=#586e75

[urgency=critical]
default-timeout=0
border-color=#dc322f

# misra's power alerts carry a chart (small multiples of the sensors, the last two
# hours): a wider card with the chart under the text at full width.
# Hidden for now (2026-10-25: not worth the screen, and critical ones never timed
# out): misra still records every alert and snapshot; `makoctl history` keeps the
# cards. Drop invisible=1 to see them again.
[app-name=misra]
invisible=1
width=400
# room for the text and the chart (mako's default cap is 100 px)
height=400
icon-location=bottom
max-icon-size=376

# Claude Code's "needs your attention" pings, sent through kitty.
[app-name=kitty summary="Claude Code"]
default-timeout=10000
border-color=#b58900

[mode=light]
background-color=#fdf6e3f2
text-color=#586e75
