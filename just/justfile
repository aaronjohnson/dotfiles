# ~/justfile (a link to ~/dotfiles/just/justfile): small things to run from home. `just` lists them.

radio := env_var('HOME') / "Music/radio"

default:
    @just --list

# The War of the Worlds, Mercury Theatre, 30 Oct 1938 (no ads; it was unsponsored)
wotw:
    mpv --no-video --really-quiet "{{radio}}/1938-10-30 Mercury Theatre - The War of the Worlds.mp3"

# play anything saved under ~/Music/radio whose name matches, e.g. `just radio worlds`
radio match:
    mpv --no-video --really-quiet "$(find "{{radio}}" -iname '*{{match}}*.mp3' | sort | head -1)"

# old-time radio: a menu of shows, then an unheard episode, saved as it plays (bin/otr); `just otr xminus` skips the menu
otr show="":
    ~/dotfiles/bin/otr {{show}}

# the last old-time radio episode again from minute N, e.g. `just again 20` (a fast-forward)
again minute="0":
    ~/dotfiles/bin/otr again {{minute}}

# the episode after the last one, in broadcast order
next:
    ~/dotfiles/bin/otr next

# queue an episode to play when this one ends, e.g. `just queue xminus grimshaw`; `just queue` lists
queue *args:
    ~/dotfiles/bin/otr queue {{args}}

# what old-time radio you heard when, newest first (~/Music/radio/listened.tsv)
history:
    ~/dotfiles/bin/otr history

# stop whatever's playing
stop:
    -~/dotfiles/bin/otr stop
