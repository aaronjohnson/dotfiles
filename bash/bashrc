# ~/.bashrc (symlink to ~/dotfiles/bash/bashrc). NixOS's /etc/bashrc runs first.
[[ $- == *i* ]] || return   # the rest is for interactive shells only

# Personal commands (hud, usbc-power, …).
PATH="$HOME/dotfiles/bin:$PATH"

# On the Linux text console, borrow the clipboard of the running Hyprland session.
# The console has no clipboard of its own and can't tell Ctrl+Shift+V from Ctrl+V.
if [[ $TERM == linux ]]; then
  for sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]; do
    [[ -S $sock ]] && export WAYLAND_DISPLAY=${sock##*/} && break
  done
  if [[ -n $WAYLAND_DISPLAY ]]; then
    # wl-copy/wl-paste now reach the desktop clipboard, and so does Emacs -nw
    # (~/.emacs.d/init.el switches to wl-clipboard when WAYLAND_DISPLAY is set).
    # At the prompt: Ctrl+V inserts the clipboard (Ctrl+Shift+C in kitty),
    # Alt+V the highlighted text (the primary selection, as middle-click).
    _paste_desktop() {
      local clip
      clip=$(wl-paste --no-newline "$@" 2>/dev/null) || return
      READLINE_LINE=${READLINE_LINE:0:READLINE_POINT}$clip${READLINE_LINE:READLINE_POINT}
      READLINE_POINT=$((READLINE_POINT + ${#clip}))
    }
    bind -x '"\C-v": _paste_desktop'
    bind -x '"\ev": _paste_desktop --primary'
  fi
fi
